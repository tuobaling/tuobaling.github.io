PkuGcLEmfP4XEKoicGk1k64U899QeIrSu3jNjdYXEzraDty6m71zLBaa1hj0oTUKmXdsKu5tLNORaNy4A8NBy%2B%2FcWSiy%2B9VI9USosEIVTIXdTP9ODmA1DgHRffRWhaeMRL%2FIUevpcmtkzbdoz6KKIu8&amp;amp;X-Amz-Signature=d0b46cb229d36bf45a2c27326f3258b6a4ce4f9187512d631c4aa513216732df&amp;amp;X-Amz-SignedHeaders=host&amp;amp;x-amz-checksum-mode=ENABLED&amp;amp;x-id=GetObject"&#10; alt="Image"&#10; loading="lazy"&#10; /&gt;&#10; &lt;/a&gt;&#10; &#10;&lt;/figure&gt;&#10;&lt;/p&gt;&#10;&lt;p&gt;&lt;a&#10; href="https://alexspot.tech/jottings-edit-pdf-title/"&#10; target="_blank" rel="noopener"&#10; class="md-link"&#10;&gt;&#10; [PDF] 解決 PDF 的標題名和檔名不同 - Alex&amp;rsquo;s Spot&#10;&lt;/a&gt;&#10;&lt;/p&gt;</description></item><item><title>ISO 27000:2023-名詞解釋-繁中版</title><link>https://tuobaling.github.io/blog/iso-27000-2023/</link><pubDate>Fri, 22 May 2026 11:06:00 +0800</pubDate><guid>https://tuobaling.github.io/blog/iso-27000-2023/</guid><description>&lt;h2 id="isoiec-270002018-繁中版-標準術語--日常用語-對照表"&gt;&#10; &lt;a href="#isoiec-270002018-%e7%b9%81%e4%b8%ad%e7%89%88-%e6%a8%99%e6%ba%96%e8%a1%93%e8%aa%9e--%e6%97%a5%e5%b8%b8%e7%94%a8%e8%aa%9e-%e5%b0%8d%e7%85%a7%e8%a1%a8" class="md-heading-anchor"&gt;&#10; ISO/IEC 27000:2018 繁中版 標準術語 ↔ 日常用語 對照表&#10; &lt;/a&gt;&#10;&lt;/h2&gt;&#10;&lt;h3 id="第-31377-節-術語與定義"&gt;&#10; &lt;a href="#%e7%ac%ac-31377-%e7%af%80-%e8%a1%93%e8%aa%9e%e8%88%87%e5%ae%9a%e7%be%a9" class="md-heading-anchor"&gt;&#10; 第 3.1～3.77 節 術語與定義&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="31-訪問控制access-control"&gt;&#10; &lt;a href="#31-%e8%a8%aa%e5%95%8f%e6%8e%a7%e5%88%b6access-control" class="md-heading-anchor"&gt;&#10; 3.1 訪問控制（Access Control）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="32-攻擊attack"&gt;&#10; &lt;a href="#32-%e6%94%bb%e6%93%8aattack" class="md-heading-anchor"&gt;&#10; 3.2 攻擊（Attack）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="33-稽核audit"&gt;&#10; &lt;a href="#33-%e7%a8%bd%e6%a0%b8audit" class="md-heading-anchor"&gt;&#10; 3.3 稽核（Audit）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;blockquote class="md-blockquote"&gt;&#10; &lt;p&gt;&lt;strong&gt;註1：&lt;/strong&gt; 稽核可以是內部稽核（第一方）或外部稽核（第二方或第三方），可以是結合稽核（結合兩個或兩個以上學科）。&lt;/p&gt;&#10;&#10; &lt;/blockquote&gt;&lt;h3 id="34-稽核範圍audit-scope"&gt;&#10; &lt;a href="#34-%e7%a8%bd%e6%a0%b8%e7%af%84%e5%9c%8daudit-scope" class="md-heading-anchor"&gt;&#10; 3.4 稽核範圍（Audit Scope）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="35-鑑別authentication"&gt;&#10; &lt;a href="#35-%e9%91%91%e5%88%a5authentication" class="md-heading-anchor"&gt;&#10; 3.5 鑑別（Authentication）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="36-真實性authenticity"&gt;&#10; &lt;a href="#36-%e7%9c%9f%e5%af%a6%e6%80%a7authenticity" class="md-heading-anchor"&gt;&#10; 3.6 真實性（Authenticity）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="37-可用性availability"&gt;&#10; &lt;a href="#37-%e5%8f%af%e7%94%a8%e6%80%a7availability" class="md-heading-anchor"&gt;&#10; 3.7 可用性（Availability）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="38-基本測度base-measure"&gt;&#10; &lt;a href="#38-%e5%9f%ba%e6%9c%ac%e6%b8%ac%e5%ba%a6base-measure" class="md-heading-anchor"&gt;&#10; 3.8 基本測度（Base Measure）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="39-能力competence"&gt;&#10; &lt;a href="#39-%e8%83%bd%e5%8a%9bcompetence" class="md-heading-anchor"&gt;&#10; 3.9 能力（Competence）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="310-保密性confidentiality"&gt;&#10; &lt;a href="#310-%e4%bf%9d%e5%af%86%e6%80%a7confidentiality" class="md-heading-anchor"&gt;&#10; 3.10 保密性（Confidentiality）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="311-符合性conformity"&gt;&#10; &lt;a href="#311-%e7%ac%a6%e5%90%88%e6%80%a7conformity" class="md-heading-anchor"&gt;&#10; 3.11 符合性（Conformity）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;h3 id="312-後果consequence"&gt;&#10; &lt;a href="#312-%e5%be%8c%e6%9e%9cconsequence" class="md-heading-anchor"&gt;&#10; 3.12 後果（Consequence）&#10; &lt;/a&gt;&#10;&lt;/h3&gt;&#10;&lt;blockquote class="md-blockquote"&gt;&#10; &lt;p&gt;&lt;strong&gt;註1：&lt;/strong&gt; 一個事態可能導致一系列後果。&lt;/p&gt;&#10;&#10; &lt;/blockquote&gt;</description></item><item><title>PowerPoint 背景圖弄不到的話，右鍵調整版面配置</title><link>https://tuobaling.github.io/blog/powerpoint-bakcground/</link><pubDate>Thu, 14 May 2026 22:34:00 +0800</pubDate><guid>https://tuobaling.github.io/blog/powerpoint-bakcground/</guid><description>&lt;p&gt;如題&lt;/p&gt;&#10;&lt;p&gt;&lt;figure class="md-image"&gt;&#10; &lt;a href="https://prod-files-secure.s3.us-west-2.amazonaws.com/1dce5fdc-84b8-4a67-b95a-ebdee75d40c4/08751bb8-363d-47cf-b26b-6f74e0e23551/messageImage_1778769030702.jpg?X-Amz-Algorithm=AWS4-HMAC-SHA256&amp;amp;X-Amz-Content-Sha256=UNSIGNED-PAYLOAD&amp;amp;X-Amz-Credential=ASIAZI2LB4662RDXCKDL%2F20261128%2Fus-west-2%2Fs3%2Faws4_request&amp;amp;X-Amz-Date=20261128T051332Z&amp;amp;X-Amz-Expires=3600&amp;amp;X-Amz-Security-Token=IQoJb3JpZ2luX2VjEBoaCXVzLXdlc3QtMiJGMEQCIApaqKFOe2rTsFxrclsSkytYdDDxW66Gr%2FzqwTLDn0A5AiA0Gndl9eieqp40ujq1SB3G6uLDMu4Vm4GoNGX%2BlG8GCCqIBAji%2F%2F%2F%2F%2F%2F%2F%2F%2F%2F8BEAAaDDYzNzQyMzE4MzgwNSIMD1NGzxvYAEOGTUOzKtwDUosdmojwAeHBu%2Bk8Zc7ao3z0HtvErQi91gwTtwITAUbGUM%2FrXus6mOP%2BVLtrPV4rbqmfh946%2BoN3Lad%2Be%2BN3f5NLL%2F1S4CAgBbSokXxj%2FzcKulnniPPoW23aniEg51mPxBSz4HWYebcaTHAGd4fY9ybuaaZD9aI9I9vX6lRufCDN8wYau%2B5EhsJty%2BC0puOT%2FdVRF%2F8No36NV8C6lmS8aym8e2ld5wNFh4loUrhoRrZBm0FG%2B38FFEohmG4WETo3DFcb9iYGPY3y%2BevAU3xBnNtABOgedmxOX3pzMdNZSN1ys79nwMYdBwdzc6fmxSo0zhJ%2Fsl0ut5cp8DAk0s1jeCqRH2Gb%2BHIuwqntsEYIvTI2qPlKhYbnTHIQ1LEH6bXKWItZpimAvuHBSZbaHqQpcI5XIw%2BPIbeW%2FPzLMWk5BtzcBTDfPzfknWyqgLOzW5RdnZxAd%2BuzUs0rKM%2F2GMBRsUuK%2FJDT%2B6da5Ksybg6nljc9lAwIe0yxcNkMUcbgufjgc8Okc79L5oxUlU3zt81EZDgO1YSzsMtXKMkH0GNObpWwEs6fWRlAUztz8VZpg8wV03u81l%2BpfyB8IsPGQOutQtJZVp%2FNSMb9fSNL%2BGTcocwKi%2F2Nkn5wtvvUpkww6euo2AY6pgH%2FSEnbpnjvVFuwAd1ttCx64PT7c8Fte9fK5B0tsj2V2u7mlmSbwC85K6BMeGMtxmsY8rRFyfYrBLtnrafoGsl9jQeMK6AoZvVwDKWzZJ1mnOuylNTP7y3FJGSQSCbyH%2FykUYEzCM%2BFgob5qYXfR4X1Ih2iBps8L13ZdtG8tfXbBmjERchRvKYVUSQ7mxBIADIcl1Y68weANWFYpiT%2FCnGKs3%2BjWnfF&amp;amp;X-Amz-Signature=cff4070c8095540ec8a74c80df0da77f000e947bc4a